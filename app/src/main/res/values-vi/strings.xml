    <!-- Onboarding strings -->
    <string name="onboardingWelcomeTitle">Chào mừng đến với ZenWedge</string>
    <string name="onboardingWelcomeDesc">ZenWedge là ứng dụng đếm ngược tập trung tinh tế, giàu trải nghiệm giác quan, giúp bạn rèn luyện sự tập trung sâu sắc, không bị phân tâm.</string>
    <string name="onboardingSlide1Feature">Điều chỉnh thời gian vật lý</string>
    <string name="onboardingSlide1FeatureDesc">Kéo trượt hình nêm mượt mà để tùy chỉnh phiên tập trung. Trải nghiệm cơ học vật lý uyển chuyển và âm thanh tích tắc êm dịu.</string>
    <string name="onboardingSoundsTitle">Không gian âm thanh thư thái</string>
    <string name="onboardingSoundsDesc">Đắm mình vào những tần số âm thanh nền trung thực cao, được thiết kế để đồng bộ hóa tần số não bộ của bạn.</string>
    <string name="onboardingSlide2Feature">Chuông trị liệu &amp; Trí tuệ nhân tạo Gemini</string>
    <string name="onboardingSlide2FeatureDesc">Làm dịu tâm trí lúc bắt đầu và kết thúc bằng chuông Tây Tạng, chiêng nhẹ hoặc để trợ lý Gemini phân tích lịch sử tập trung để đề xuất âm thanh tối ưu nhất.</string>
    <string name="onboardingStatsTitle">Phân tích &amp; Tùy biến sâu</string>
    <string name="onboardingStatsDesc">Theo dõi xu hướng tập trung của bạn thông qua cơ sở dữ liệu Room DB cục bộ cùng các cài đặt cá nhân hóa giao diện toàn diện.</string>
    <string name="onboardingSlide3Feature">Nhận định lịch sử phong phú</string>
    <string name="onboardingSlide3FeatureDesc">Xem lại biểu đồ tập trung, xuất nhật ký định dạng CSV, và điều chỉnh thông báo khoảng thời gian, cường độ rung hoặc giao diện tối.</string>
